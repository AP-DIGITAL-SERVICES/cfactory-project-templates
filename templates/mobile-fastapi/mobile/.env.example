# Mobile environment variables (use expo-constants or react-native-config)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_NAME={{projectName}}
{{#if (or (eq decision_pushNotifications "fcm") (eq decision_pushNotifications "fcm-apns"))}}
# Firebase Cloud Messaging
EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id
{{/if}}{{#if (eq decision_pushNotifications "fcm-apns")}}
# APNs
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
{{/if}}
