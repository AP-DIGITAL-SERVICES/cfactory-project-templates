{
  "name": "{{projectName}}-mobile",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@reduxjs/toolkit": "^2.2.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.9",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.14",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.3",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.32.0",
    "react-redux": "^9.1.0"{{#if (eq decision_offlineSupport "offline-first")}},
    "@react-native-async-storage/async-storage": "^1.23.1",
    "redux-persist": "^6.0.0"{{/if}}{{#if (or (eq decision_realtime "websocket") (eq decision_streaming "websocket"))}},
    "socket.io-client": "^4.7.0"{{/if}}{{#if (or (eq decision_pushNotifications "fcm") (eq decision_pushNotifications "fcm-apns"))}},
    "expo-notifications": "~0.28.2",
    "expo-device": "~6.0.1"{{/if}}
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.5.1",
    "@types/react": "~18.2.45",
    "@types/react-native": "~0.74.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
