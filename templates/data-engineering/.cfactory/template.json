{
  "version": 1,
  "id": "platform.data-engineering",
  "title": "Data engineering",
  "description": "Full-kit starter for data-engineering (bootstrap, devops, constitution, SDD overlays).",
  "tags": [
    "data-engineering",
    "data",
    "python"
  ],
  "capabilities": [
    "sdd",
    "devops",
    "data"
  ],
  "engine": "handlebars",
  "parameters": [
    {
      "key": "project_name",
      "label": "Project name",
      "required": true
    },
    {
      "key": "stack",
      "label": "Stack",
      "default": "data-engineering",
      "required": true
    },
    {
      "key": "caching",
      "label": "caching",
      "message": "Does your project need caching?",
      "default": "none",
      "choices": [
        {
          "label": "No caching needed",
          "value": "none"
        },
        {
          "label": "Redis (distributed cache)",
          "value": "redis"
        },
        {
          "label": "In-memory only (single instance)",
          "value": "in-memory"
        }
      ]
    },
    {
      "key": "queue",
      "label": "queue",
      "message": "Does your project need message queues / async processing?",
      "default": "none",
      "choices": [
        {
          "label": "No queues needed",
          "value": "none"
        },
        {
          "label": "Amazon SQS (managed)",
          "value": "sqs"
        }
      ]
    },
    {
      "key": "streaming",
      "label": "streaming",
      "message": "Does your project need event streaming / real-time data pipelines?",
      "default": "none",
      "choices": [
        {
          "label": "No streaming needed",
          "value": "none"
        },
        {
          "label": "Redis Streams",
