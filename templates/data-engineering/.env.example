# Data warehouse
{{#if (eq decision_dataWarehouse "postgresql")}}DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{projectName}}
{{/if}}{{#if (eq decision_dataWarehouse "bigquery")}}GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
BIGQUERY_DATASET={{projectName}}
{{/if}}{{#if (eq decision_dataWarehouse "snowflake")}}SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_DATABASE={{projectName}}
SNOWFLAKE_SCHEMA=PUBLIC
{{/if}}{{#if (eq decision_dataWarehouse "duckdb")}}DUCKDB_PATH=./data/{{projectName}}.duckdb
{{/if}}
{{#if (eq decision_orchestrator "airflow")}}# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://postgres:postgres@localhost:5432/airflow
{{/if}}{{#if (eq decision_orchestrator "prefect")}}# Prefect
PREFECT_API_URL=http://localhost:4200/api
{{/if}}
