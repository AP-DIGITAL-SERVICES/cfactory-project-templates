# MCP transport: stdio | http | sse
MCP_TRANSPORT={{decision_mcpTransport}}
PORT=8000
{{#if (eq decision_mcpAuth "jwt-bearer")}}
# JWT authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600
{{/if}}{{#if (eq decision_mcpAuth "oauth2")}}
# OAuth2
OAUTH2_ISSUER_URL=https://your-provider.example.com
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
{{/if}}{{#if (eq decision_mcpSidecars "postgres")}}
# PostgreSQL sidecar
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{projectName}}
{{/if}}{{#if (eq decision_mcpSidecars "redis")}}
# Redis sidecar
REDIS_URL=redis://localhost:6379/0
{{/if}}
