# Application
NODE_ENV=development
PORT=3000

# Database — PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{projectName}}
{{#if (or (eq decision_caching "redis") (eq decision_queue "bullmq") (eq decision_backgroundJobs "bullmq-repeatable") (eq decision_streaming "redis-streams"))}}
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}{{#if (eq decision_streaming "kafka")}}
# Kafka
KAFKA_BROKERS=localhost:9092
{{/if}}{{#if (eq decision_search "meilisearch")}}
# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey
{{/if}}{{#if (eq decision_search "elasticsearch")}}
# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
{{/if}}{{#if (eq decision_fileStorage "s3")}}
# AWS S3 / MinIO
AWS_S3_BUCKET=my-bucket
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
{{/if}}{{#if (eq decision_fileStorage "gcs")}}
# Google Cloud Storage
GCS_BUCKET=my-bucket
GOOGLE_APPLICATION_CREDENTIALS=./config/gcs-service-account.json
{{/if}}{{#if (eq decision_fileStorage "azure-blob")}}
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER=my-container
{{/if}}
