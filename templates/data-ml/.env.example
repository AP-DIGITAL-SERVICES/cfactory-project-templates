# Data paths
DATA_DIR=./data
MODEL_DIR=./models
{{#if (eq decision_experimentTracking "mlflow")}}
# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME={{projectName}}
{{/if}}{{#if (eq decision_experimentTracking "wandb")}}
# Weights & Biases
WANDB_PROJECT={{projectName}}
WANDB_API_KEY=your-api-key
{{/if}}{{#if (eq decision_featureStore "redis-features")}}
# Redis feature cache
REDIS_URL=redis://localhost:6379/0
{{/if}}{{#if (eq decision_modelServing "fastapi")}}
# Serving
SERVING_PORT=8000
{{/if}}
