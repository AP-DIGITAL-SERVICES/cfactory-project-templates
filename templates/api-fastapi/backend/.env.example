# Application
DEBUG=false

# Database — PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{projectName}}
{{#if (or (eq decision_caching "redis") (eq decision_queue "celery") (eq decision_queue "arq") (eq decision_backgroundJobs "celery-beat") (eq decision_streaming "redis-streams"))}}
# Redis
REDIS_URL=redis://localhost:6379/0
{{/if}}{{#if (eq decision_streaming "kafka")}}
# Kafka
KAFKA_BROKERS=localhost:9092
{{/if}}{{#if (eq decision_search "meilisearch")}}
# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey
{{/if}}{{#if (eq decision_search "elasticsearch")}}
# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
{{/if}}{{#if (eq decision_fileStorage "s3")}}
# AWS S3 / MinIO
AWS_S3_BUCKET=my-bucket
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
{{/if}}{{#if (eq decision_fileStorage "gcs")}}
# Google Cloud Storage
GCS_BUCKET=my-bucket
GOOGLE_APPLICATION_CREDENTIALS=./config/gcs-service-account.json
{{/if}}{{#if (eq decision_fileStorage "azure-blob")}}
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER=my-container
{{/if}}
