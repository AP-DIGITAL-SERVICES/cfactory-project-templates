{
  "name": "{{projectName}}",
  "version": "0.0.1",
  "description": "{{projectName}} API — NestJS backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.0",
    "pg": "^8.11.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"{{#if (eq decision_caching "redis")}},
    "ioredis": "^5.3.2",
    "@nestjs/cache-manager": "^3.0.0",
    "cache-manager": "^7.0.0",
    "cache-manager-ioredis-yet": "^2.1.0"{{/if}}{{#if (or (eq decision_queue "bullmq") (eq decision_backgroundJobs "bullmq-repeatable"))}},
    "bullmq": "^5.0.0",
    "@nestjs/bullmq": "^11.0.0"{{/if}}{{#if (eq decision_backgroundJobs "nestjs-schedule")}},
    "@nestjs/schedule": "^6.0.0"{{/if}}{{#if (eq decision_streaming "websocket")}},
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "socket.io": "^4.7.0"{{/if}}{{#if (eq decision_search "meilisearch")}},
    "meilisearch": "^0.39.0"{{/if}}{{#if (eq decision_search "elasticsearch")}},
    "@elastic/elasticsearch": "^8.12.0"{{/if}}{{#if (eq decision_fileStorage "s3")}},
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"{{/if}}{{#if (eq decision_fileStorage "gcs")}},
    "@google-cloud/storage": "^7.0.0"{{/if}}{{#if (eq decision_fileStorage "azure-blob")}},
    "@azure/storage-blob": "^12.0.0"{{/if}}
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
